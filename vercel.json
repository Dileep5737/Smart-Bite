{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix smartbite/frontend run build",
  "installCommand": "npm --prefix smartbite/frontend install",
  "outputDirectory": "smartbite/frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
